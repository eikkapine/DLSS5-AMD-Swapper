<Window x:Class="Dlss5AmdSwapper.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DLSS5 AMD Swapper" Width="1280" Height="820" MinWidth="1080" MinHeight="680"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResizeWithGrip"
        Icon="Assets/Dlss5AmdSwapper.ico"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="18"/>
        </Style>

        <Style x:Key="BadgeStyle" TargetType="Border">
            <Setter Property="Background" Value="#1B2230"/>
            <Setter Property="BorderBrush" Value="#2B3548"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="9,4"/>
            <Setter Property="Margin" Value="0,0,7,0"/>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style x:Key="TopButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#1B2230"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GameListItem" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,9"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Outer" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="12" Padding="14">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Outer" Property="Background" Value="{StaticResource CardHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Outer" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="Outer" Property="Background" Value="#201A1C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border BorderBrush="#202735" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="58"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#0D1016" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" MouseLeftButtonDown="TopBar_MouseLeftButtonDown">
                <Grid Margin="18,0,8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="30" Height="30" CornerRadius="8" Margin="0,0,10,0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#FF4E43" Offset="0"/>
                                    <GradientStop Color="#FF8846" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <TextBlock Text="5" Foreground="White" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="DLSS5" FontWeight="Bold" FontSize="14"/>
                            <TextBlock Text="AMD SWAPPER" Foreground="{StaticResource MutedBrush}" FontWeight="SemiBold" FontSize="9"/>
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding PageTitle}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#14251E" BorderBrush="#255B40" BorderThickness="1" CornerRadius="8" Padding="10,5" Margin="0,0,10,0" VerticalAlignment="Center">
                            <Grid VerticalAlignment="Center">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <Ellipse Width="7" Height="7" Fill="{StaticResource SuccessBrush}" Margin="0,0,7,0" VerticalAlignment="Center" SnapsToDevicePixels="True"/>
                                <TextBlock Grid.Column="1" Text="AMD route ready" FontSize="11" Foreground="#A7F3C7" VerticalAlignment="Center" Padding="0,1,0,0"/>
                            </Grid>
                        </Border>
                        <Button Style="{StaticResource TopButton}" Content="—" Click="Minimize_Click" ToolTip="Minimize"/>
                        <Button Style="{StaticResource TopButton}" Content="×" Click="Close_Click" ToolTip="Close" FontSize="18"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="#0C0F15" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0">
                    <Grid Margin="14,18,14,14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel>
                            <Button Style="{StaticResource NavButton}" Tag="Home" Click="Nav_Click">
                                <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE80F;" Width="28"/><TextBlock Text="Overview"/></StackPanel>
                            </Button>
                            <Button Style="{StaticResource NavButton}" Tag="Games" Click="Nav_Click">
                                <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE7FC;" Width="28"/><TextBlock Text="Game library"/></StackPanel>
                            </Button>
                            <Button Style="{StaticResource NavButton}" Tag="Lossless" Click="Nav_Click">
                                <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE7F4;" Width="28"/><TextBlock Text="Lossless Scaling"/></StackPanel>
                            </Button>
                            <Button Style="{StaticResource NavButton}" Tag="Settings" Click="Nav_Click">
                                <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE713;" Width="28"/><TextBlock Text="Settings"/></StackPanel>
                            </Button>
                        </StackPanel>
                        <Border Grid.Row="2" Background="#111721" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="11" Padding="12">
                            <StackPanel>
                                <TextBlock Text="GLOBAL CONTROLS" Foreground="{StaticResource MutedBrush}" FontSize="9" FontWeight="Bold"/>
                                <TextBlock Text="Ctrl + Alt + F6" FontWeight="SemiBold" Margin="0,8,0,0"/>
                                <TextBlock Text="Toggle effect" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                                <TextBlock Text="F7  /  F8" FontWeight="SemiBold" Margin="0,8,0,0"/>
                                <TextBlock Text="Decrease / increase" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                                <TextBlock Text="{Binding HotkeyStatus}" Foreground="{StaticResource MutedBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <Grid Grid.Column="1" Background="{StaticResource BgBrush}">
                    <Grid Margin="26,22,26,28">
                            <!-- Overview -->
                            <ScrollViewer x:Name="HomePage" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                              <StackPanel>
                                <Grid Margin="0,0,0,18">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="1.35*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" CornerRadius="16" Padding="24" BorderBrush="#5C302D" BorderThickness="1">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="#291719" Offset="0"/>
                                                <GradientStop Color="#141821" Offset="0.72"/>
                                                <GradientStop Color="#10151D" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="AMD NEURAL RENDERING" Foreground="#FF8B69" FontSize="10" FontWeight="Bold"/>
                                                <TextBlock Text="Install the rich path directly into supported games." FontSize="25" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,8,0,8"/>
                                                <TextBlock Text="Uses real FSR colour, motion and depth inputs when the game exposes them. The app verifies compatibility, the official upstream installer and the resulting runtime state before calling it ready." Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" MaxWidth="620" HorizontalAlignment="Left" TextAlignment="Left"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                                                    <Button Style="{StaticResource PrimaryButton}" Content="Add a game" Click="AddGame_Click"/>
                                                    <Button Style="{StaticResource GhostButton}" Content="Scan PC" Click="ScanGames_Click" Margin="10,0,0,0"/>
                                                </StackPanel>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" FontFamily="Segoe Fluent Icons" Text="&#xE7F8;" FontSize="54" Foreground="#45313A" VerticalAlignment="Center" Margin="24,0,4,0"/>
                                        </Grid>
                                    </Border>
                                    <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                                        <StackPanel>
                                            <TextBlock Text="LOSSLESS SCALING" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="Bold"/>
                                            <TextBlock Text="Universal desktop route" FontSize="18" FontWeight="SemiBold" Margin="0,8,0,6"/>
                                            <TextBlock Text="Native visible output with only the hidden neural branch capped at 480p. Press Scale normally after setup." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" FontSize="12"/>
                                            <Border Background="#101C18" BorderBrush="#214A37" BorderThickness="1" CornerRadius="9" Padding="10" Margin="0,16,0,0">
                                                <TextBlock Text="{Binding LosslessStatusText}" Foreground="#9FE6BE" TextWrapping="Wrap" FontSize="11"/>
                                            </Border>
                                            <Button Style="{StaticResource GhostButton}" Content="Open Lossless Scaling setup" Tag="Lossless" Click="Nav_Click" Margin="0,12,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <TextBlock Text="Selected game" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                <Border Style="{StaticResource CardStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding SelectedGame.Name, TargetNullValue=No game selected, FallbackValue=No game selected}" FontSize="20" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding SelectedGame.ExePath, TargetNullValue=Add or scan a game to begin, FallbackValue=Add or scan a game to begin}" Foreground="{StaticResource MutedBrush}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                                <Border Style="{StaticResource BadgeStyle}"><TextBlock Text="{Binding SelectedGame.CompatibilityLabel, TargetNullValue=Not checked, FallbackValue=Not checked}" FontSize="10"/></Border>
                                                <Border Style="{StaticResource BadgeStyle}"><TextBlock Text="{Binding SelectedGame.InstallLabel, TargetNullValue=Not installed, FallbackValue=Not installed}" FontSize="10"/></Border>
                                                <Border Style="{StaticResource BadgeStyle}"><TextBlock Text="{Binding SelectedGame.RuntimeStatus, TargetNullValue=Runtime idle, FallbackValue=Runtime idle}" FontSize="10"/></Border>
                                            </StackPanel>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                                            <Button Style="{StaticResource GhostButton}" Content="Details" Tag="Games" Click="Nav_Click"/>
                                            <Button Style="{StaticResource PrimaryButton}" Content="Set up Neural Rendering" Click="InstallSelected_Click" Margin="10,0,0,0" IsEnabled="{Binding SelectedGame.Eligible}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                              </StackPanel>
                            </ScrollViewer>

                            <!-- Game library -->
                            <Grid x:Name="GamesPage" Visibility="Collapsed">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="360"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Grid Grid.Column="0">
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Game library" FontSize="20" FontWeight="SemiBold"/>
                                            <TextBlock Text="Steam, Epic, GOG, EA, Ubisoft, Battle.net, Xbox + standalone" Foreground="{StaticResource MutedBrush}" FontSize="10" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Style="{StaticResource GhostButton}" Content="Scan PC" Click="ScanGames_Click" Margin="8,0"/>
                                        <Button Grid.Column="2" Style="{StaticResource PrimaryButton}" Content="Add" Click="AddGame_Click"/>
                                    </Grid>
                                    <ListBox Grid.Row="1" x:Name="GamesList" ItemsSource="{Binding Games}" SelectedItem="{Binding SelectedGame, Mode=TwoWay}" ItemContainerStyle="{StaticResource GameListItem}" Background="Transparent" BorderThickness="0" ScrollViewer.VerticalScrollBarVisibility="Hidden" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="True">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding Status}" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,4,0,0"/>
                                                        <TextBlock Text="{Binding Store}" Foreground="#FF8B69" FontSize="9" FontWeight="Bold" Margin="0,5,0,0"/>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1" FontFamily="Segoe Fluent Icons" Text="&#xE72A;" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Grid>

                                <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                                  <StackPanel>
                                    <TextBlock Text="{Binding SelectedGame.Name, TargetNullValue=Select a game, FallbackValue=Select a game}" FontSize="23" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding SelectedGame.ExePath, TargetNullValue=No target selected, FallbackValue=No target selected}" Foreground="{StaticResource MutedBrush}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,4,0,16"/>

                                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="DIRECT-GAME STATUS" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="Bold"/>
                                                <TextBlock Text="{Binding SelectedGame.Status, TargetNullValue=Waiting for a game}" FontSize="17" FontWeight="SemiBold" Margin="0,7,0,0"/>
                                                <TextBlock Text="x64 + FSR + DX12 are required. Common anti-cheat targets are blocked automatically." Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
                                                <Button Style="{StaticResource GhostButton}" Content="Re-check" Click="ProbeSelected_Click"/>
                                                <Button Style="{StaticResource PrimaryButton}" Content="Set up" Click="InstallSelected_Click" Margin="9,0,0,0" IsEnabled="{Binding SelectedGame.Eligible}"/>
                                                <Button Style="{StaticResource DangerButton}" Content="Restore" Click="RestoreSelected_Click" Margin="9,0,0,0" IsEnabled="{Binding SelectedGame.Installed}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Border Style="{StaticResource CardStyle}">
                                            <StackPanel>
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                    <StackPanel><TextBlock Text="Neural Rendering" FontWeight="SemiBold"/><TextBlock Text="Configured on/off state" Foreground="{StaticResource MutedBrush}" FontSize="10"/></StackPanel>
                                                    <CheckBox Grid.Column="1" x:Name="DirectEnabledSwitch" Style="{StaticResource SwitchStyle}" IsChecked="{Binding SelectedGame.Enabled, Mode=OneWay}" IsEnabled="{Binding SelectedGame.Installed}" Click="DirectEnabledSwitch_Click" VerticalAlignment="Center"/>
                                                </Grid>
                                                <TextBlock Text="Ctrl+Alt+F6 changes this setting for the active managed game. A live badge appears only when the running runtime acknowledges the reload." Foreground="{StaticResource MutedBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,12,0,0"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                                            <StackPanel>
                                                <TextBlock Text="Runtime" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding SelectedGame.RuntimeStatus, TargetNullValue=Not checked}" Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0"/>
                                                <TextBlock Text="Press End in-game for the upstream live overlay." Foreground="#FF9A77" FontSize="10" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                                        <StackPanel>
                                            <TextBlock Text="Effect controls" FontSize="16" FontWeight="SemiBold"/>
                                            <TextBlock Text="These map to the upstream AMD runtime settings. The app never reports a live change unless the runtime log acknowledges it." Foreground="{StaticResource MutedBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,4,0,15"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="55"/></Grid.ColumnDefinitions>
                                                <TextBlock Text="Structure" VerticalAlignment="Center"/>
                                                <Slider Grid.Column="1" x:Name="StructureSlider" Minimum="0" Maximum="2" TickFrequency="0.1" Value="{Binding SelectedGame.LocalStructure, Mode=OneWay}" PreviewMouseLeftButtonUp="StructureSlider_MouseUp" Margin="8,0"/>
                                                <TextBlock Grid.Column="2" Text="{Binding SelectedGame.LocalStructure, StringFormat=F1}" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#FF9A77"/>
                                            </Grid>
                                            <Grid Margin="0,12,0,0">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="55"/></Grid.ColumnDefinitions>
                                                <TextBlock Text="Local tone" VerticalAlignment="Center"/>
                                                <Slider Grid.Column="1" x:Name="ToneSlider" Minimum="0" Maximum="2" TickFrequency="0.1" Value="{Binding SelectedGame.LocalTone, Mode=OneWay}" PreviewMouseLeftButtonUp="ToneSlider_MouseUp" Margin="8,0"/>
                                                <TextBlock Grid.Column="2" Text="{Binding SelectedGame.LocalTone, StringFormat=F1}" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#FF9A77"/>
                                            </Grid>
                                            <Grid Margin="0,12,0,0">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="55"/></Grid.ColumnDefinitions>
                                                <TextBlock Text="Skin structure" VerticalAlignment="Center"/>
                                                <Slider Grid.Column="1" x:Name="SkinSlider" Minimum="0" Maximum="2" TickFrequency="0.1" Value="{Binding SelectedGame.SkinStructure, Mode=OneWay}" PreviewMouseLeftButtonUp="SkinSlider_MouseUp" Margin="8,0"/>
                                                <TextBlock Grid.Column="2" Text="{Binding SelectedGame.SkinStructure, StringFormat=F1}" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#FF9A77"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource CardStyle}">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="Log-backed diagnostics" FontSize="16" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding DiagnosticsSummary}" Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0"/>
                                                <TextBlock Text="{Binding DiagnosticsDetail}" Foreground="#9FE6BE" FontSize="10" TextWrapping="Wrap" Margin="0,7,0,0"/>
                                            </StackPanel>
                                            <Button Grid.Column="1" Style="{StaticResource GhostButton}" Content="Refresh evidence" Click="RefreshDiagnostics_Click" VerticalAlignment="Center" Margin="18,0,0,0"/>
                                        </Grid>
                                    </Border>
                                  </StackPanel>
                                </ScrollViewer>
                            </Grid>

                            <!-- Lossless Scaling -->
                            <ScrollViewer x:Name="LosslessPage" Visibility="Collapsed" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                              <StackPanel>
                                <Grid Margin="0,0,0,18">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Lossless Scaling route" FontSize="23" FontWeight="SemiBold"/>
                                        <TextBlock Text="Automatic activation when you press Scale. Native output stays at the captured resolution; only the neural pass is capped at 480p by default." Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" MaxWidth="760" Margin="0,5,0,0" HorizontalAlignment="Left" TextAlignment="Left"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Style="{StaticResource GhostButton}" Content="Refresh" Click="RefreshLossless_Click" VerticalAlignment="Center"/>
                                </Grid>

                                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="STATUS" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="Bold"/>
                                            <TextBlock Text="{Binding LosslessStatusText}" FontSize="17" FontWeight="SemiBold" Margin="0,7,0,0"/>
                                            <TextBlock Text="{Binding LosslessInstallPath}" Foreground="{StaticResource MutedBrush}" FontSize="10" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                                            <Button Style="{StaticResource PrimaryButton}" Content="Install / Update bridge" Click="InstallLossless_Click"/>
                                            <Button Style="{StaticResource DangerButton}" Content="Uninstall" Click="UninstallLossless_Click" Margin="9,0,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource CardStyle}">
                                        <StackPanel>
                                            <TextBlock Text="Visible output" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="Bold"/>
                                            <TextBlock Text="Native source resolution" FontSize="18" FontWeight="SemiBold" Margin="0,7,0,0"/>
                                            <TextBlock Text="The compositor keeps the original frame as the base, so 1440p stays 1440p on screen." Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                                        <StackPanel>
                                            <TextBlock Text="Neural workload" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="Bold"/>
                                            <TextBlock Text="480p max height" FontSize="18" FontWeight="SemiBold" Margin="0,7,0,0"/>
                                            <TextBlock Text="This limits the expensive hidden neural branch without changing the final visible resolution." Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <Border Style="{StaticResource CardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="Private runtime files" FontSize="16" FontWeight="SemiBold"/>
                                        <TextBlock Text="These files stay on your PC and are never copied into the repository or a public release." Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,4,0,14"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="145"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="AMD proxy" VerticalAlignment="Center"/>
                                            <TextBox Grid.Column="1" Text="{Binding LosslessProxyPath, UpdateSourceTrigger=PropertyChanged}" Margin="8,0"/>
                                            <Button Grid.Column="2" Style="{StaticResource GhostButton}" Content="Browse" Click="BrowseLosslessProxy_Click"/>
                                        </Grid>
                                        <Grid Margin="0,10,0,0">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="145"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="nvngx_dlssnr.dll" VerticalAlignment="Center"/>
                                            <TextBox Grid.Column="1" Text="{Binding LosslessNrPath, UpdateSourceTrigger=PropertyChanged}" Margin="8,0"/>
                                            <Button Grid.Column="2" Style="{StaticResource GhostButton}" Content="Browse" Click="BrowseLosslessNr_Click"/>
                                        </Grid>
                                        <Grid Margin="0,10,0,0">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="145"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="HIP device index" VerticalAlignment="Center"/>
                                            <TextBox Grid.Column="1" Text="{Binding HipVisibleDevices, UpdateSourceTrigger=PropertyChanged}" Margin="8,0"/>
                                            <TextBlock Grid.Column="2" Text="GPU index used by the AMD runtime" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" FontSize="10"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                              </StackPanel>
                            </ScrollViewer>

                            <!-- Settings -->
                            <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                              <StackPanel>
                                <TextBlock Text="Runtime sources" FontSize="23" FontWeight="SemiBold"/>
                                <TextBlock Text="Direct-game setup is prepared automatically. The official AMD installer is downloaded from its GitHub release and verified before use; the NVIDIA Neural Rendering DLL is found only from legitimate local copies on this PC." Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,5,0,18" MaxWidth="820" HorizontalAlignment="Left" TextAlignment="Left"/>
                                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="AUTOMATIC RUNTIME SOURCES" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="Bold"/>
                                                <TextBlock Text="{Binding RuntimeSourcesStatus}" FontSize="17" FontWeight="SemiBold" Margin="0,7,0,0" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding RuntimeSetupStatus}" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,6,0,0" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding RuntimeNrStatus}" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <Button Grid.Column="1" Style="{StaticResource GhostButton}" Content="Check now" Click="RefreshRuntimeSources_Click" Margin="18,0,0,0" VerticalAlignment="Center"/>
                                        </Grid>
                                        <Expander Header="Manual fallback" Foreground="{StaticResource MutedBrush}" Margin="0,16,0,0">
                                            <StackPanel Margin="0,12,0,0">
                                                <TextBlock Style="{StaticResource FieldLabel}" Text="OFFICIAL SETUP OVERRIDE"/>
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                    <TextBox Text="{Binding UpstreamSetupPath, UpdateSourceTrigger=PropertyChanged}"/>
                                                    <Button Grid.Column="1" Style="{StaticResource GhostButton}" Content="Browse" Click="BrowseSetup_Click" Margin="9,0,0,0"/>
                                                </Grid>
                                                <TextBlock Style="{StaticResource FieldLabel}" Text="NVNGX_DLSSNR.DLL" Margin="0,15,0,6"/>
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                    <TextBox Text="{Binding NvngxDlssNrPath, UpdateSourceTrigger=PropertyChanged}"/>
                                                    <Button Grid.Column="1" Style="{StaticResource GhostButton}" Content="Browse" Click="BrowseNr_Click" Margin="9,0,0,0"/>
                                                </Grid>
                                            </StackPanel>
                                        </Expander>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource CardStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel HorizontalAlignment="Left">
                                            <TextBlock Text="Global hotkeys" FontWeight="SemiBold" FontSize="15"/>
                                            <TextBlock Text="The manager registers Ctrl+Alt+F6/F7/F8 only while a managed direct-game target is running. Lossless Scaling keeps control of the same keys while its bridge is active." Foreground="{StaticResource MutedBrush}" FontSize="10" TextWrapping="Wrap" MaxWidth="690" Margin="0,4,0,0" HorizontalAlignment="Left" TextAlignment="Left"/>
                                        </StackPanel>
                                        <CheckBox Grid.Column="1" Style="{StaticResource SwitchStyle}" IsChecked="{Binding RegisterHotkeys, Mode=TwoWay}" Click="HotkeysSetting_Click" VerticalAlignment="Center" Margin="18,0,0,0"/>
                                    </Grid>
                                </Border>
                              </StackPanel>
                            </ScrollViewer>
                    </Grid>

                    <Border x:Name="Toast" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="24" Background="#202A37" BorderBrush="#3A465A" BorderThickness="1" CornerRadius="11" Padding="14,10" Visibility="Collapsed" MaxWidth="480">
                        <TextBlock x:Name="ToastText" TextWrapping="Wrap" FontSize="11"/>
                    </Border>
                </Grid>
            </Grid>

            <Grid x:Name="ScanSummaryOverlay" Grid.RowSpan="2" Background="#B8000000" Visibility="Collapsed" Panel.ZIndex="100">
                <Border Width="620" MaxWidth="620" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="28"
                        Background="#0D1118" BorderBrush="#30394B" BorderThickness="1" CornerRadius="16" Padding="24">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Width="44" Height="44" CornerRadius="12" Margin="0,0,14,0" VerticalAlignment="Center">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#FF4E43" Offset="0"/>
                                        <GradientStop Color="#FF8846" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE73E;" Foreground="White" FontSize="19" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Left">
                                <TextBlock Text="Game scan verified" FontSize="22" FontWeight="SemiBold"/>
                                <TextBlock Text="The library was deduplicated and every discovered target was checked." Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap" HorizontalAlignment="Left" TextAlignment="Left"/>
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="1" Margin="0,24,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="14">
                                <StackPanel><TextBlock x:Name="ScanTotalText" FontSize="22" FontWeight="Bold"/><TextBlock Text="Found" Foreground="{StaticResource MutedBrush}" FontSize="10"/></StackPanel>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="14">
                                <StackPanel><TextBlock x:Name="ScanReadyText" FontSize="22" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}"/><TextBlock Text="Ready" Foreground="{StaticResource MutedBrush}" FontSize="10"/></StackPanel>
                            </Border>
                            <Border Grid.Column="4" Style="{StaticResource CardStyle}" Padding="14">
                                <StackPanel><TextBlock x:Name="ScanReviewText" FontSize="22" FontWeight="Bold" Foreground="{StaticResource WarningBrush}"/><TextBlock Text="Review" Foreground="{StaticResource MutedBrush}" FontSize="10"/></StackPanel>
                            </Border>
                            <Border Grid.Column="6" Style="{StaticResource CardStyle}" Padding="14">
                                <StackPanel><TextBlock x:Name="ScanBlockedText" FontSize="22" FontWeight="Bold" Foreground="{StaticResource DangerBrush}"/><TextBlock Text="Blocked" Foreground="{StaticResource MutedBrush}" FontSize="10"/></StackPanel>
                            </Border>
                        </Grid>

                        <Border Grid.Row="2" Background="#111721" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="11" Padding="14">
                            <StackPanel HorizontalAlignment="Left">
                                <TextBlock Text="SOURCES" Foreground="{StaticResource MutedBrush}" FontSize="9" FontWeight="Bold"/>
                                <TextBlock x:Name="ScanSourcesText" TextWrapping="Wrap" Margin="0,6,0,0" FontSize="11" HorizontalAlignment="Left" TextAlignment="Left"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Grid.Row="3" Text="No game was selected automatically. Pick one from the library when you want to configure it."
                                   Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" HorizontalAlignment="Left" TextAlignment="Left" Margin="0,14"/>

                        <Button x:Name="ScanSummaryDoneButton" Grid.Row="4" Style="{StaticResource PrimaryButton}" Content="Done"
                                Click="ScanSummaryDone_Click" HorizontalAlignment="Right" MinWidth="100" IsDefault="True"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
